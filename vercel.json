{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build && cp index.html dist/client/index.html",
  "outputDirectory": "dist/client",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?!assets|fonts|.*\\..*).*)", "destination": "/index.html" }
  ]
}
